      },
      "note": "The west chamber holds Avatar of Hakkar, the east chamber holds Jammal’an, and the southern rooms lead to the Shade. Clear the six defenders on the Upper balconies section first."
    },
    {
      "id": "entrance",
      "name": "Entrance and outer ring",
      "image": "./assets/maps/sunken-temple-entrance.webp",
      "width": 526,
      "height": 697,
      "worldProjection": {
        "originX": -253.17,
        "originY": 227.05,
        "pixelsPerYard": 2.0
      },
      "note": "Start at the portal. The stair branches at the entrance lead to the upper balconies and the lower statue route. Spawn of Hakkar patrols the outer ring of the lower halls."
    },
    {
      "id": "lower",
      "name": "Lower statues and pit",
      "image": "./assets/maps/sunken-temple-main.webp",
      "width": 1011,
      "height": 957,
      "worldProjection": {
        "originX": -253.84,
        "originY": 348.1,
        "pixelsPerYard": 2.0
      },
      "note": "Take the descending stairs from the entrance hall. Statue order: S → N → SW → SE → NW → NE. The altar is below the north statue, and Atal’alarion and the idol are in the pit."
    },
    {
      "id": "balconies",
      "name": "Upper defender balconies",
      "image": "./assets/maps/sunken-temple-balconies.webp",
      "width": 686,
      "height": 858,
      "worldProjection": {
        "originX": -221.17,
        "originY": 266.74,
        "pixelsPerYard": 2.0
      },
      "note": "Take the ascending stairs from the entrance hall. Clear one defender on each of the six balconies to open Jammal’an’s chamber. Individual names are not assigned to fixed balconies in the Classic records."
    },
    {
      "id": "approach",
      "name": "Swamp of Sorrows approach",
      "image": "./assets/maps/swamp-of-sorrows.webp",
